{
  "version": 2,
  "builds": [
    {
      "src": "counter/wsgi.py",
      "use": "@vercel/python",
      "config": { 
        "maxLambdaSize": "15mb", 
        "runtime": "python3.12"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "counter/wsgi.py"
    }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1",
    "DATABASE_URL": "postgresql://postgres.yobovutojnghilewndmt:Awaaladinjeff7@aws-1-eu-west-1.pooler.supabase.com:6543/postgres",
    "DEBUG": "False"
  },
  "github": {
    "silent": false,
    "autoAlias": true
  },
  "buildCommand": "bash build_files.sh",
  "installCommand": "pip install -r requirements.txt",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
